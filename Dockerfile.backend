# syntax=docker/dockerfile:1
# PhishGuard Backend - Hardened Multi-Stage Dockerfile

# Stage 1: Build & Dependencies
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libxml2-dev \
    libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Minimal Runtime Environment
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2 \
    libxslt1.1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged user & group
RUN groupadd -g 10001 phishguard && \
    useradd -u 10001 -g phishguard -s /bin/bash -m phishguard

# Copy installed Python packages from builder
COPY --from=builder /root/.local /home/phishguard/.local
ENV PATH=/home/phishguard/.local/bin:$PATH
ENV PYTHONPATH=/app/backend

# Copy application code
COPY backend/ /app/backend/
COPY .env.example /app/.env

# Create data directories with appropriate permissions
RUN mkdir -p /app/data/evidence /app/data/reports && \
    chown -R phishguard:phishguard /app

USER phishguard

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]

