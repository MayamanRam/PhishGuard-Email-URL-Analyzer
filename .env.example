# Application Environment
PHISHGUARD_ENV=development
PHISHGUARD_APP_NAME="PhishGuard Phishing Threat Analysis Platform"
PHISHGUARD_VERSION="1.0.0"
DEBUG=true

# Server Network Binding (Loopback Only)
PHISHGUARD_HOST=127.0.0.1
PHISHGUARD_PORT=8000

# Allowed Frontend Origins (Strict CORS & Origin Matching)
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Allowed Host Headers (TrustedHostMiddleware)
ALLOWED_HOSTS=["127.0.0.1","localhost","127.0.0.1:8000","localhost:8000","testserver"]

# Database Configuration (SQLite default with WAL mode)
# Left commented to allow dynamic absolute path resolution via config.py
# DATABASE_URL=sqlite:///./data/phishguard.db

# Evidence and Report Storage Paths
EVIDENCE_DIR=./data/evidence
REPORTS_DIR=./data/reports
PSL_FILE_PATH=./data/psl/public_suffix_list.dat

# Security & Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
RATE_LIMIT_PER_MINUTE=60
CSRF_CLIENT_HEADER="X-PhishGuard-Client"
CSRF_EXPECTED_VALUE="web-console"

# Evidence Retention Policy (Days)
EVIDENCE_RETENTION_DAYS=90

